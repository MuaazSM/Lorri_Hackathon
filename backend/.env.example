# Database connection string
# For local dev, SQLite is used. For production, swap to PostgreSQL.
# Example PostgreSQL: postgresql://lorri_postgres_user:PASSWORD@dpg-HOSTNAME:5432/lorri_postgres
DATABASE_URL=sqlite:///./dev.db

# Render PostgreSQL (production)
# Get Internal Database URL from your Render PostgreSQL dashboard
# DATABASE_URL=postgresql://lorri_postgres_user:PASSWORD@dpg-d7nnan57vvec7398du1g-a:5432/lorri_postgres

# Google Gemini API key — primary LLM for all 4 agents
# Get yours at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here